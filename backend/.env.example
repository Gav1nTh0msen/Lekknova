# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=lekknova_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/lekknova_db

# Application Configuration
APP_ENV=development
DEBUG=True

# Security & Auth Settings
# Generate a secure key in your terminal with: openssl rand -hex 32
SECRET_KEY=change_this_to_a_secure_random_32_byte_hex_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
